# Безпечний режим за замовчуванням: OpenAI не викликається, Telegram не публікує.
TEST_MODE=true
# Дозволяйте автоматичну публікацію лише свідомо разом із TEST_MODE=false.
AUTO_PUBLISH=false
DEBUG=false
DATABASE_URL=sqlite:///./aibot/aibot.db
REDIS_URL=redis://localhost:6379/0
DEFAULT_LANGUAGE=uk
REQUEST_TIMEOUT=20

# OpenAI (потрібно лише при TEST_MODE=false)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram API: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=aibot_session
TELEGRAM_TARGET_CHANNEL=@your_channel
